# .env.production.example
# Copy this file to .env.production and update values for your production environment
# Do NOT commit .env.production with real values to version control

# Application Identity
VITE_APP_NAME=Reflex Sprint
VITE_ENVIRONMENT=production

# Public URLs (required for social sharing & Open Graph meta tags)
# Update to your actual production domain
VITE_PUBLIC_URL=https://your-domain.com

# Build & Analytics Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=false

# Optional: Add these if you implement analytics or error tracking
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X          # Google Analytics ID
# VITE_POSTHOG_API_KEY=phc_xxxxxxxxxxxx     # PostHog API key
# VITE_SENTRY_DSN=https://xxxx@sentry.io/x # Sentry error tracking DSN
